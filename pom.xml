<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.gestionamateur</groupId>
    <artifactId>TPI-ProgAv</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          COMPATIBILIDAD JAVA 17 (OBS-001).
          Se usa 'release' en lugar de 'source'/'target' para que el compilador valide las
          APIs disponibles en Java 17, incluso cuando la compilacion se ejecuta con un JDK
          posterior (por ejemplo JDK 25). Asi el artefacto no puede enlazar contra APIs
          que no existan en el runtime soportado.
        -->
        <maven.compiler.release>17</maven.compiler.release>
        <exec.mainClass>com.gestionamateur.tpi.progav.TPIProgAv</exec.mainClass>
        <tpi.it.habilitado>false</tpi.it.habilitado>
        <it.test>**/*IT.java</it.test>
        <skipITs>false</skipITs>
    </properties>

    <!-- Dependencias externas del proyecto -->
    <dependencies>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.2.1</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.2</version>
        </dependency>
        <!-- Testing automatizado con JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- release=17 garantiza compatibilidad de bytecode y de APIs con Java 17 -->
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                    <systemPropertyVariables>
                        <!--
                          AISLAMIENTO FAIL-CLOSED (DEF-004 / CORR-E2-MAVEN-IT-01).
                          Por defecto solo se ejecutan suites unitarias (*Test). Las suites *IT
                          requieren explicitamente el perfil '-Pintegracion' y '-Dtpi.it.habilitado=true',
                          ademas de una URL explicita en TPI_TEST_DB_URL.
                        -->
                        <tpi.it.habilitado>${tpi.it.habilitado}</tpi.it.habilitado>
                        <TPI_TEST_DB_URL>${env.TPI_TEST_DB_URL}</TPI_TEST_DB_URL>
                        <TPI_TEST_DB_USER>${env.TPI_TEST_DB_USER}</TPI_TEST_DB_USER>
                        <TPI_TEST_DB_PASSWORD>${env.TPI_TEST_DB_PASSWORD}</TPI_TEST_DB_PASSWORD>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.gestionamateur.tpi.progav.TPIProgAv</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>false</overWriteSnapshots>
                            <overWriteIfNewer>true</overWriteIfNewer>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Perfil explicito (sin auto-activacion por entorno): ejecuta suites *IT en fase integration-test -->
        <profile>
            <id>integracion</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.2.5</version>
                        <executions>
                            <execution>
                                <id>pruebas-integracion</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <skipTests>${skipITs}</skipTests>
                                    <test>${it.test}</test>
                                    <includes>
                                        <include>**/*IT.java</include>
                                    </includes>
                                    <excludes>
                                        <exclude>**/*Test.java</exclude>
                                    </excludes>
                                    <runOrder>alphabetical</runOrder>
                                    <parallel>none</parallel>
                                    <forkCount>1</forkCount>
                                    <reuseForks>true</reuseForks>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
