<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.gestionamateur</groupId>
    <artifactId>TPI-ProgAv</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          COMPATIBILIDAD JAVA 17 (OBS-001).
          Se usa 'release' en lugar de 'source'/'target' para que el compilador valide las
          APIs disponibles en Java 17, incluso cuando la compilacion se ejecuta con un JDK
          posterior (por ejemplo JDK 25). Asi el artefacto no puede enlazar contra APIs
          que no existan en el runtime soportado.
        -->
        <maven.compiler.release>17</maven.compiler.release>
        <exec.mainClass>com.gestionamateur.tpi.progav.TPIProgAv</exec.mainClass>
    </properties>

    <!-- Dependencias externas del proyecto -->
    <dependencies>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.2.1</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.2</version>
        </dependency>
        <!-- Testing automatizado con JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- release=17 garantiza compatibilidad de bytecode y de APIs con Java 17 -->
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <!--
                          AISLAMIENTO FAIL-CLOSED (DEF-004).
                          La URL de la base de pruebas NO se fija en el proyecto: debe proveerse
                          de forma explicita por variable de entorno o propiedad del sistema.
                          Si la variable no esta definida, Maven inyecta la referencia sin resolver
                          y ConexionBD aborta la corrida con un mensaje accionable antes de abrir
                          cualquier conexion. No existe ningun fallback hacia una base reservada.
                          Uso:  $env:TPI_TEST_DB_URL = "jdbc:postgresql://127.0.0.1:55432/<base_de_pruebas>"
                        -->
                        <TPI_TEST_DB_URL>${env.TPI_TEST_DB_URL}</TPI_TEST_DB_URL>
                        <TPI_TEST_DB_USER>${env.TPI_TEST_DB_USER}</TPI_TEST_DB_USER>
                        <TPI_TEST_DB_PASSWORD>${env.TPI_TEST_DB_PASSWORD}</TPI_TEST_DB_PASSWORD>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.gestionamateur.tpi.progav.TPIProgAv</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>false</overWriteSnapshots>
                            <overWriteIfNewer>true</overWriteIfNewer>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
